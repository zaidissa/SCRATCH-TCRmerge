// Compute settings applied by Cirro on top of nextflow.config.
//
// The merge itself is metadata-only (the .h5ad is copied and only /obs is
// rewritten), so this is a small, single-node job. Raise process_medium memory
// only if you enable "Also write a TCR-only object", which reads the matrix for
// the kept cells.

process {
    withLabel: process_low {
        cpus   = 6
        memory = '64.GB'
    }
    withLabel: process_medium {
        cpus   = 12
        memory = '250.GB'
    }
}
