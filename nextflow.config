// SCRATCH-TCRmerge — Nextflow configuration
//
// NOTE: docker is enabled globally and there is no `profiles` block, matching how
// Cirro launches pipelines (it passes no -profile). Do not add one without also
// updating the Cirro process definition.

params {
    // ── inputs (Cirro's preprocess.py fills these in) ─────────────────────────
    gex_h5ad    = null      // GEX AnnData (.h5ad)
    tcr_tables  = null      // comma-separated per-cell TCR tables, or a glob

    // Other files from TCRtoolkit's bridge/merged_vdj_object/ (per-sample summaries,
    // *_seurat.rds, *_combineTCR.rds, pre_qc_cells.tsv). These are NOT joined - the
    // summaries are per-sample rather than per-cell, the .rds files are R objects, and
    // pre_qc_cells.tsv repeats the same barcodes. They are republished under
    // tcr_source/ so the merged dataset carries the whole TCR bundle.
    tcr_passthrough = null  // comma-separated list, filled in by Cirro's preprocess.py

    // Per-contig side table (one row per chain per cell, which .obs cannot hold).
    // contigs_before_qc keeps second alpha/beta chains that VDJ_QC strips; the after_qc
    // table is used only to set a passed_vdj_qc column. airr_files add the FULL contig
    // sequence - without them only the assembled V(D)J regions (~340 of ~500 nt) are known.
    contigs            = null
    contigs_passed_qc  = null
    airr_files         = null

    // ── output ───────────────────────────────────────────────────────────────
    outdir      = "results"

    // ── column contract of the TCR table ─────────────────────────────────────
    // Defaults match TCRtoolkit's bridge/merged_vdj_object/post_qc_cells.tsv
    sample_col   = "sample"
    barcode_col  = "barcode"
    cell_id_col  = "cell_id"

    // ── join behaviour ───────────────────────────────────────────────────────
    obs_prefix      = "tcr_"   // prefix for added .obs columns; avoids clobbering GEX columns
    // Library-type words dropped from sample names (as whole tokens) before matching, so
    // paired libraries like BTC-GBM-001-001-GEX and BTC-GBM-001-001-TCR line up. Empty
    // string disables normalisation and matches sample names exactly.
    library_tokens  = "GEX,TCR,VDJ,BCR,ADT"
    min_match_rate  = 0.01     // abort if the best barcode candidate matches less than this
    subset_to_tcr   = false    // also write merged.tcr_only.h5ad (reads X for kept cells)
    emit_rds        = true     // also write .rds copies of the output tables

    // ── execution ────────────────────────────────────────────────────────────
    // Reuses the TCRtoolkit single-cell image: it already ships anndata, h5py,
    // pandas and R/Seurat, so no new image is needed.
    container   = "syedsazaidi/scratch-tcr:latest"
    max_cpus    = 24
    max_memory  = "400.GB"
    max_time    = "50.h"
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    withLabel: process_low {
        cpus   = 4
        memory = '64.GB'
        time   = '12.h'
    }
    withLabel: process_medium {
        cpus   = 12
        memory = '400.GB'
        time   = '40.h'
    }
    errorStrategy = 'terminate'
}

manifest {
    name            = 'SCRATCH-TCRmerge'
    description     = 'Join per-cell TCR tables onto a GEX AnnData by barcode'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}
